# Activate only after DNS-01 certificate issuance and router local DNS setup.
# npm run setup:domain -- beatsync.example.com writes the real .env for you.
# Router local DNS: beatsync.example.com -> your Mac's reserved LAN IPv4.
# BEATSYNC_ORIGIN=https://beatsync.example.com:3443
# TLS_CERT="/absolute/path/to/fullchain.pem"
# TLS_KEY="/absolute/path/to/privkey.pem"
PORT=3000
HTTPS_PORT=3443
